<!--
Configure additional MSBuild properties for your project in this file:
- Step 1: Add this file to your .fernignore file to ensure it is not overwritten.
- Step 2: Modify this file to your liking.

Excluded from af-sdk-generation's verify-csharp.sh sync (same pattern as
every other language's manifest file) so it survives every regen - this is
the designated place for package metadata Fern doesn't know about, instead
of editing the Fern-owned ApifreaksApi.csproj directly.
-->
<Project>
  <PropertyGroup>
    <PackageId>ApifreaksApi</PackageId>
    <Title>APIFreaks .NET SDK</Title>
    <Authors>APIFreaks</Authors>
    <Company>APIFreaks</Company>
    <Description>Official .NET SDK for the APIFreaks APIs.</Description>
    <PackageProjectUrl>https://apifreaks.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/api-freaks/af-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>apifreaks;api;sdk;geolocation;whois;domain</PackageTags>
  </PropertyGroup>
</Project>
